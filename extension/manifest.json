{
  "manifest_version": 3,
  "name": "FlexDL",
  "description": "Download media as an MP4 video or MP3 through a local service.",
  "version": "2.0.0",
  "permissions": [
    "alarms",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:43110/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FlexDL",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
